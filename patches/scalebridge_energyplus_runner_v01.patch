@@ -0,0 +1,458 @@
+"""Cross-platform process runner for prepared EnergyPlus simulation cases.
+
+This module owns the narrow boundary between ScaleBridge and the EnergyPlus
+command-line executable. It does not edit IDF files, select output variables,
+parse time-series data, write manifests, or interact with MLflow. Those
+responsibilities remain in separate modules so this runner can be reused from
+plain Python loops, multiprocessing workers, and SLURM jobs.
+
+The runner:
+
+1. validates the prepared IDF, EPW, executable, and output locations;
+2. constructs an argument-safe EnergyPlus command;
+3. executes one simulation without invoking a shell;
+4. persists captured standard-output and standard-error logs; and
+5. summarizes ``eplusout.err`` and ``eplusout.end`` diagnostics.
+
+Runtime simulation failures are returned as structured ``EnergyPlusRunResult``
+objects so a batch can record the failure and continue. Preflight errors, such
+as missing input files or an unavailable executable, raise explicit exceptions
+before EnergyPlus starts.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import shutil
+import subprocess
+from collections.abc import Mapping, Sequence
+from pathlib import Path
+
+from pydantic import BaseModel, ConfigDict, Field
+
+
+# EnergyPlus writes these standard files into the selected output directory.
+ENERGYPLUS_ERROR_FILENAME = "eplusout.err"
+ENERGYPLUS_END_FILENAME = "eplusout.end"
+STDOUT_LOG_FILENAME = "energyplus.stdout.log"
+STDERR_LOG_FILENAME = "energyplus.stderr.log"
+
+# Diagnostic summary lines vary slightly by EnergyPlus release, so the parser
+# accepts whitespace and singular/plural wording around the numeric counts.
+SUMMARY_COUNT_PATTERNS = {
+    "warning_count": re.compile(r"(?P<count>\d+)\s+Warning(?:s)?", re.IGNORECASE),
+    "severe_count": re.compile(r"(?P<count>\d+)\s+Severe Error(?:s)?", re.IGNORECASE),
+    "fatal_count": re.compile(r"(?P<count>\d+)\s+Fatal Error(?:s)?", re.IGNORECASE),
+}
+
+
+class EnergyPlusRunnerError(RuntimeError):
+    """Base exception for failures that prevent EnergyPlus from starting."""
+
+
+class EnergyPlusExecutableNotFoundError(EnergyPlusRunnerError):
+    """Raised when the configured EnergyPlus executable cannot be resolved."""
+
+
+class EnergyPlusInputError(EnergyPlusRunnerError):
+    """Raised when required simulation inputs are absent or invalid."""
+
+
+class EnergyPlusLaunchError(EnergyPlusRunnerError):
+    """Raised when the operating system cannot launch the EnergyPlus process."""
+
+
+class EnergyPlusRunResult(BaseModel):
+    """Structured outcome of one EnergyPlus command-line execution.
+
+    Attributes
+    ----------
+    command:
+        Exact argument sequence passed to ``subprocess.run``.
+    output_directory:
+        Directory containing EnergyPlus outputs and captured process logs.
+    return_code:
+        Process return code reported by the operating system.
+    completed_successfully:
+        True only when the process, end file, and fatal-error checks pass.
+    warning_count, severe_count, fatal_count:
+        Counts extracted from the EnergyPlus error summary when available.
+    end_file_success:
+        Whether ``eplusout.end`` explicitly reports successful completion.
+    timed_out:
+        Whether ScaleBridge terminated the wait after the configured timeout.
+    """
+
+    model_config = ConfigDict(extra="forbid", frozen=True)
+
+    command: tuple[str, ...]
+    output_directory: Path
+    return_code: int | None = None
+    completed_successfully: bool = False
+    warning_count: int = Field(default=0, ge=0)
+    severe_count: int = Field(default=0, ge=0)
+    fatal_count: int = Field(default=0, ge=0)
+    end_file_success: bool = False
+    timed_out: bool = False
+    stdout_log_path: Path
+    stderr_log_path: Path
+    error_file_path: Path | None = None
+    end_file_path: Path | None = None
+    failure_message: str | None = None
+
+
+def parse_energyplus_error_summary(error_text: str) -> tuple[int, int, int]:
+    """Extract warning, severe-error, and fatal-error counts.
+
+    Parameters
+    ----------
+    error_text:
+        Complete textual content of an EnergyPlus ``eplusout.err`` file.
+
+    Returns
+    -------
+    tuple[int, int, int]
+        Warning, severe-error, and fatal-error counts in that order.
+
+    Notes
+    -----
+    EnergyPlus emits detailed warning lines as well as a final aggregate
+    summary. Searching the entire text and retaining the final match avoids
+    counting individual diagnostic lines manually.
+    """
+    counts: dict[str, int] = {}
+
+    # The final regex match for each category corresponds to the summary line
+    # when a normal EnergyPlus error file is available.
+    for field_name, pattern in SUMMARY_COUNT_PATTERNS.items():
+        matches = list(pattern.finditer(error_text))
+        counts[field_name] = int(matches[-1].group("count")) if matches else 0
+
+    return (
+        counts["warning_count"],
+        counts["severe_count"],
+        counts["fatal_count"],
+    )
+
+
+def energyplus_end_file_succeeded(end_text: str) -> bool:
+    """Return whether an EnergyPlus end file reports successful completion.
+
+    Parameters
+    ----------
+    end_text:
+        Complete textual content of ``eplusout.end``.
+    """
+    normalized = " ".join(end_text.casefold().split())
+    return "energyplus completed successfully" in normalized
+
+
+def resolve_energyplus_executable(
+    configured_executable: str | Path | None = None,
+) -> Path:
+    """Resolve the EnergyPlus executable using explicit and environment inputs.
+
+    Resolution order is:
+
+    1. the explicit ``configured_executable`` argument;
+    2. the ``ENERGYPLUS_EXE`` environment variable; and
+    3. ``energyplus`` on the current ``PATH``.
+
+    Parameters
+    ----------
+    configured_executable:
+        Optional executable path or command name supplied by application
+        configuration.
+
+    Returns
+    -------
+    pathlib.Path
+        Resolved executable path.
+
+    Raises
+    ------
+    EnergyPlusExecutableNotFoundError
+        If no executable can be resolved.
+    """
+    candidate = configured_executable or os.environ.get("ENERGYPLUS_EXE") or "energyplus"
+    candidate_path = Path(candidate).expanduser()
+
+    # Explicit paths should be validated directly. Bare command names are
+    # delegated to shutil.which for platform-specific extension handling.
+    looks_like_path = candidate_path.is_absolute() or candidate_path.parent != Path(".")
+    resolved = (
+        str(candidate_path.resolve())
+        if looks_like_path and candidate_path.is_file()
+        else shutil.which(str(candidate))
+    )
+
+    if resolved is None:
+        raise EnergyPlusExecutableNotFoundError(
+            "EnergyPlus executable was not found. Provide executable=..., set "
+            "ENERGYPLUS_EXE, or add energyplus to PATH."
+        )
+
+    return Path(resolved)
+
+
+class EnergyPlusRunner:
+    """Execute prepared EnergyPlus IDF/EPW pairs through the command line.
+
+    Parameters
+    ----------
+    executable:
+        Optional EnergyPlus executable path or command name. Resolution is
+        deferred until ``run`` so constructing the runner has no side effects.
+    timeout_seconds:
+        Optional maximum execution time for each simulation.
+    environment:
+        Optional environment-variable overrides merged onto the current
+        process environment for the EnergyPlus child process.
+    extra_arguments:
+        Optional command-line arguments inserted before the prepared IDF path.
+        This supports version-specific EnergyPlus options without changing the
+        stable runner API.
+    """
+
+    def __init__(
+        self,
+        executable: str | Path | None = None,
+        *,
+        timeout_seconds: float | None = None,
+        environment: Mapping[str, str] | None = None,
+        extra_arguments: Sequence[str] = (),
+    ) -> None:
+        if timeout_seconds is not None and timeout_seconds <= 0:
+            raise ValueError("timeout_seconds must be greater than zero")
+
+        self._configured_executable = executable
+        self._timeout_seconds = timeout_seconds
+        self._environment_overrides = dict(environment or {})
+        self._extra_arguments = tuple(str(argument) for argument in extra_arguments)
+
+    def build_command(
+        self,
+        *,
+        executable: Path,
+        idf_path: Path,
+        epw_path: Path,
+        output_directory: Path,
+    ) -> tuple[str, ...]:
+        """Build the shell-independent EnergyPlus command argument sequence.
+
+        Parameters
+        ----------
+        executable:
+            Resolved EnergyPlus executable.
+        idf_path:
+            Prepared IDF file to simulate.
+        epw_path:
+            Weather file used by the simulation.
+        output_directory:
+            Destination for EnergyPlus output files.
+        """
+        return (
+            str(executable),
+            "--weather",
+            str(epw_path),
+            "--output-directory",
+            str(output_directory),
+            *self._extra_arguments,
+            str(idf_path),
+        )
+
+    def run(
+        self,
+        *,
+        idf_path: str | Path,
+        epw_path: str | Path,
+        output_directory: str | Path,
+    ) -> EnergyPlusRunResult:
+        """Execute one prepared EnergyPlus case and summarize its diagnostics.
+
+        Parameters
+        ----------
+        idf_path:
+            Path to the prepared IDF containing all requested outputs.
+        epw_path:
+            Path to the EPW weather file.
+        output_directory:
+            Dedicated output directory for this execution attempt.
+
+        Returns
+        -------
+        EnergyPlusRunResult
+            Process, diagnostic, and output-location summary.
+
+        Raises
+        ------
+        EnergyPlusInputError
+            If an input is missing, has the wrong file extension, or the output
+            destination conflicts with an existing file.
+        EnergyPlusExecutableNotFoundError
+            If EnergyPlus cannot be resolved.
+        EnergyPlusLaunchError
+            If the operating system fails before the process starts.
+        """
+        # ------------------------------------------------------------------
+        # Phase 1: Normalize and validate all filesystem inputs.
+        # ------------------------------------------------------------------
+        prepared_idf = Path(idf_path).expanduser().resolve()
+        weather_file = Path(epw_path).expanduser().resolve()
+        run_output = Path(output_directory).expanduser().resolve()
+
+        self._validate_input_file(prepared_idf, expected_suffix=".idf", label="IDF")
+        self._validate_input_file(weather_file, expected_suffix=".epw", label="EPW")
+
+        if run_output.exists() and not run_output.is_dir():
+            raise EnergyPlusInputError(
+                f"EnergyPlus output location exists but is not a directory: {run_output}"
+            )
+        run_output.mkdir(parents=True, exist_ok=True)
+
+        executable = resolve_energyplus_executable(self._configured_executable)
+        command = self.build_command(
+            executable=executable,
+            idf_path=prepared_idf,
+            epw_path=weather_file,
+            output_directory=run_output,
+        )
+
+        # ------------------------------------------------------------------
+        # Phase 2: Execute without a shell to preserve argument boundaries.
+        # ------------------------------------------------------------------
+        child_environment = os.environ.copy()
+        child_environment.update(self._environment_overrides)
+
+        timed_out = False
+        failure_message: str | None = None
+
+        try:
+            completed_process = subprocess.run(
+                command,
+                check=False,
+                capture_output=True,
+                text=True,
+                timeout=self._timeout_seconds,
+                env=child_environment,
+            )
+            return_code: int | None = completed_process.returncode
+            stdout_text = completed_process.stdout or ""
+            stderr_text = completed_process.stderr or ""
+        except subprocess.TimeoutExpired as exc:
+            timed_out = True
+            return_code = None
+            stdout_text = self._coerce_process_output(exc.stdout)
+            stderr_text = self._coerce_process_output(exc.stderr)
+            failure_message = (
+                f"EnergyPlus exceeded the configured timeout of "
+                f"{self._timeout_seconds} seconds."
+            )
+        except OSError as exc:
+            raise EnergyPlusLaunchError(
+                f"Operating system could not launch EnergyPlus: {exc}"
+            ) from exc
+
+        # ------------------------------------------------------------------
+        # Phase 3: Persist process streams independently of EnergyPlus files.
+        # ------------------------------------------------------------------
+        stdout_log_path = run_output / STDOUT_LOG_FILENAME
+        stderr_log_path = run_output / STDERR_LOG_FILENAME
+        stdout_log_path.write_text(stdout_text, encoding="utf-8")
+        stderr_log_path.write_text(stderr_text, encoding="utf-8")
+
+        # ------------------------------------------------------------------
+        # Phase 4: Inspect standard EnergyPlus diagnostic artifacts.
+        # ------------------------------------------------------------------
+        error_file = run_output / ENERGYPLUS_ERROR_FILENAME
+        end_file = run_output / ENERGYPLUS_END_FILENAME
+
+        error_text = (
+            error_file.read_text(encoding="utf-8", errors="replace")
+            if error_file.exists()
+            else ""
+        )
+        end_text = (
+            end_file.read_text(encoding="utf-8", errors="replace")
+            if end_file.exists()
+            else ""
+        )
+
+        warning_count, severe_count, fatal_count = parse_energyplus_error_summary(error_text)
+        end_file_success = energyplus_end_file_succeeded(end_text)
+
+        # Successful completion requires agreement between the OS return code,
+        # the EnergyPlus end file, and the fatal diagnostic count.
+        completed_successfully = (
+            not timed_out
+            and return_code == 0
+            and end_file_success
+            and fatal_count == 0
+        )
+
+        if not completed_successfully and failure_message is None:
+            failure_message = self._build_failure_message(
+                return_code=return_code,
+                end_file_exists=end_file.exists(),
+                end_file_success=end_file_success,
+                fatal_count=fatal_count,
+            )
+
+        return EnergyPlusRunResult(
+            command=command,
+            output_directory=run_output,
+            return_code=return_code,
+            completed_successfully=completed_successfully,
+            warning_count=warning_count,
+            severe_count=severe_count,
+            fatal_count=fatal_count,
+            end_file_success=end_file_success,
+            timed_out=timed_out,
+            stdout_log_path=stdout_log_path,
+            stderr_log_path=stderr_log_path,
+            error_file_path=error_file if error_file.exists() else None,
+            end_file_path=end_file if end_file.exists() else None,
+            failure_message=failure_message,
+        )
+
+    @staticmethod
+    def _validate_input_file(path: Path, *, expected_suffix: str, label: str) -> None:
+        """Validate one required EnergyPlus input file."""
+        if not path.is_file():
+            raise EnergyPlusInputError(f"{label} file does not exist: {path}")
+        if path.suffix.casefold() != expected_suffix:
+            raise EnergyPlusInputError(
+                f"{label} file must use the {expected_suffix} extension: {path}"
+            )
+
+    @staticmethod
+    def _coerce_process_output(value: str | bytes | None) -> str:
+        """Convert subprocess timeout output into UTF-8 text."""
+        if value is None:
+            return ""
+        if isinstance(value, bytes):
+            return value.decode("utf-8", errors="replace")
+        return value
+
+    @staticmethod
+    def _build_failure_message(
+        *,
+        return_code: int | None,
+        end_file_exists: bool,
+        end_file_success: bool,
+        fatal_count: int,
+    ) -> str:
+        """Construct a concise explanation for an unsuccessful simulation."""
+        reasons: list[str] = []
+
+        if return_code != 0:
+            reasons.append(f"process return code was {return_code}")
+        if not end_file_exists:
+            reasons.append(f"{ENERGYPLUS_END_FILENAME} was not produced")
+        elif not end_file_success:
+            reasons.append(f"{ENERGYPLUS_END_FILENAME} did not report success")
+        if fatal_count:
+            reasons.append(f"EnergyPlus reported {fatal_count} fatal error(s)")
+
+        return "; ".join(reasons) or "EnergyPlus completion could not be validated"
