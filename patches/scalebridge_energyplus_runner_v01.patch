@@ -0,0 +1,188 @@
+"""Tests for the cross-platform prepared-case EnergyPlus process runner."""
+
+from __future__ import annotations
+
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from scalebridge.integration.energyplus import (
+    EnergyPlusExecutableNotFoundError,
+    EnergyPlusInputError,
+    EnergyPlusRunner,
+)
+from scalebridge.integration.energyplus.simulation.runner import (
+    energyplus_end_file_succeeded,
+    parse_energyplus_error_summary,
+    resolve_energyplus_executable,
+)
+
+
+SUCCESSFUL_ERROR_FILE = """
+Program Version,EnergyPlus, Version 9.6.0
+EnergyPlus Completed Successfully-- 3 Warning; 1 Severe Errors
+"""
+
+FAILED_ERROR_FILE = """
+Program Version,EnergyPlus, Version 9.6.0
+************* EnergyPlus Terminated-- 2 Warning; 4 Severe Errors; 1 Fatal Error
+"""
+
+
+def _write_inputs(tmp_path: Path) -> tuple[Path, Path, Path]:
+    """Create minimal placeholder input and executable files for runner tests."""
+    idf_path = tmp_path / "prepared.idf"
+    epw_path = tmp_path / "weather.epw"
+    executable = tmp_path / "energyplus.exe"
+
+    idf_path.write_text("Version,9.6;\n", encoding="utf-8")
+    epw_path.write_text("LOCATION,Test\n", encoding="utf-8")
+    executable.write_text("", encoding="utf-8")
+    return idf_path, epw_path, executable
+
+
+def test_error_summary_parser_uses_final_counts() -> None:
+    """The diagnostic parser must recover aggregate warning and error counts."""
+    assert parse_energyplus_error_summary(SUCCESSFUL_ERROR_FILE) == (3, 1, 0)
+    assert parse_energyplus_error_summary(FAILED_ERROR_FILE) == (2, 4, 1)
+
+
+def test_end_file_success_is_case_and_whitespace_insensitive() -> None:
+    """EnergyPlus success recognition must tolerate normal formatting changes."""
+    assert energyplus_end_file_succeeded("EnergyPlus Completed Successfully.\n")
+    assert energyplus_end_file_succeeded(" ENERGYPLUS   completed SUCCESSFULLY ")
+    assert not energyplus_end_file_succeeded("EnergyPlus Terminated--Fatal Error")
+
+
+def test_runner_returns_successful_structured_result(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """A valid process and end file must produce a successful run result."""
+    idf_path, epw_path, executable = _write_inputs(tmp_path)
+    output_directory = tmp_path / "outputs"
+
+    def fake_run(command, **kwargs):
+        """Simulate EnergyPlus producing its standard diagnostic files."""
+        output_directory.mkdir(parents=True, exist_ok=True)
+        (output_directory / "eplusout.err").write_text(
+            SUCCESSFUL_ERROR_FILE,
+            encoding="utf-8",
+        )
+        (output_directory / "eplusout.end").write_text(
+            "EnergyPlus Completed Successfully.\n",
+            encoding="utf-8",
+        )
+        return subprocess.CompletedProcess(
+            args=command,
+            returncode=0,
+            stdout="EnergyPlus stdout",
+            stderr="",
+        )
+
+    monkeypatch.setattr(subprocess, "run", fake_run)
+
+    result = EnergyPlusRunner(executable=executable).run(
+        idf_path=idf_path,
+        epw_path=epw_path,
+        output_directory=output_directory,
+    )
+
+    assert result.completed_successfully
+    assert result.warning_count == 3
+    assert result.severe_count == 1
+    assert result.fatal_count == 0
+    assert result.end_file_success
+    assert result.stdout_log_path.read_text(encoding="utf-8") == "EnergyPlus stdout"
+    assert result.failure_message is None
+
+
+def test_runner_returns_failed_result_without_raising(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """Runtime EnergyPlus failure must be returned so batch loops can continue."""
+    idf_path, epw_path, executable = _write_inputs(tmp_path)
+    output_directory = tmp_path / "outputs"
+
+    def fake_run(command, **kwargs):
+        """Simulate a completed process that reports fatal EnergyPlus errors."""
+        output_directory.mkdir(parents=True, exist_ok=True)
+        (output_directory / "eplusout.err").write_text(
+            FAILED_ERROR_FILE,
+            encoding="utf-8",
+        )
+        (output_directory / "eplusout.end").write_text(
+            "EnergyPlus Terminated--Fatal Error Detected.\n",
+            encoding="utf-8",
+        )
+        return subprocess.CompletedProcess(
+            args=command,
+            returncode=1,
+            stdout="",
+            stderr="simulation failed",
+        )
+
+    monkeypatch.setattr(subprocess, "run", fake_run)
+
+    result = EnergyPlusRunner(executable=executable).run(
+        idf_path=idf_path,
+        epw_path=epw_path,
+        output_directory=output_directory,
+    )
+
+    assert not result.completed_successfully
+    assert result.return_code == 1
+    assert result.fatal_count == 1
+    assert "return code was 1" in result.failure_message
+    assert "1 fatal error" in result.failure_message
+
+
+def test_runner_converts_timeout_to_failed_result(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """A process timeout must retain logs and return a failed result."""
+    idf_path, epw_path, executable = _write_inputs(tmp_path)
+
+    def fake_run(command, **kwargs):
+        """Simulate subprocess timeout output in byte form."""
+        raise subprocess.TimeoutExpired(
+            command,
+            timeout=5,
+            output=b"partial stdout",
+            stderr=b"partial stderr",
+        )
+
+    monkeypatch.setattr(subprocess, "run", fake_run)
+
+    result = EnergyPlusRunner(executable=executable, timeout_seconds=5).run(
+        idf_path=idf_path,
+        epw_path=epw_path,
+        output_directory=tmp_path / "outputs",
+    )
+
+    assert result.timed_out
+    assert not result.completed_successfully
+    assert result.return_code is None
+    assert result.stdout_log_path.read_text(encoding="utf-8") == "partial stdout"
